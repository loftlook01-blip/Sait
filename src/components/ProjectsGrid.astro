---
import Art from './Art.astro';
import { PROJECTS, PROJECT_CATS } from '../data/content';
interface Props {
  limit?: number;
  filter?: boolean;
}
const { limit, filter = false } = Astro.props;
const cats = PROJECT_CATS.filter((c) => PROJECTS.some((p) => p.cat === c.id));
const list = limit ? PROJECTS.slice(0, limit) : PROJECTS;
---

{
  filter && (
    <div class="filters" role="group" aria-label="Фильтр проектов" data-pj-filter>
      <button type="button" aria-pressed="true" data-cat="all">Все</button>
      {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c.id}>{c.label}</button>)}
    </div>
  )
}

<div class:list={['projects', { filtered: filter }]} data-pj-grid>
  {
    list.map((p, i) => (
      <a href={`/portfolio/${p.slug}/`} class:list={['pj reveal', { big: !filter && (i % 4 === 0 || i % 4 === 3) }]} data-cat={p.cat}>
        <div class="pj-media media">
          <Art variant={p.art} photo={p.photos?.[0]} />
          {p.concept && <span class="concept">Концепт студии</span>}
        </div>
        <div class="pj-info">
          <div>
            <h3 class="h-card">{p.title}</h3>
            <p class="muted">{p.type} · {p.area} м² · {p.district}</p>
          </div>
          <span class="days">
            <b>{p.days}</b> дней
          </span>
        </div>
      </a>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pj-filter]').forEach((bar) => {
    const grid = bar.nextElementSibling as HTMLElement;
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
      if (!btn) return;
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const cat = btn.dataset.cat;
      const apply = () =>
        grid.querySelectorAll<HTMLElement>('.pj').forEach((card) => {
          card.hidden = cat !== 'all' && card.dataset.cat !== cat;
        });
      const d = document as Document & { startViewTransition?: (cb: () => void) => void };
      if (d.startViewTransition) d.startViewTransition(apply);
      else apply();
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .filters button {
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 0.92rem var(--font-sans);
    cursor: pointer;
    transition: 0.2s;
  }

  .filters button:hover {
    border-color: var(--ink);
  }

  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .pj[hidden] {
    display: none;
  }

  .projects {
    display: grid;
    gap: clamp(16px, 2vw, 28px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
  }

  @media (min-width: 1100px) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }

    .big {
      grid-column: span 2;
    }

    .big .pj-media {
      aspect-ratio: 16 / 9.4;
    }
  }

  .pj {
    display: grid;
    gap: 16px;
    text-decoration: none;
  }

  .pj-media {
    aspect-ratio: 4 / 3.4;
  }

  .pj-media :global(.art) {
    transition: transform 0.9s var(--ease);
  }

  .pj:hover .pj-media :global(.art) {
    transform: scale(1.04);
  }

  .concept {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(251 249 246 / 0.9);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .pj-info {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: start;
  }

  .pj-info p {
    margin: 4px 0 0;
    font-size: 0.9rem;
  }

  .days {
    white-space: nowrap;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .days b {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--ink);
  }
</style>
