---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { ACTIVE_CITIES, cityBase, cityServiceUrl, type City } from '../data/cities';
import { SERVICES } from '../data/services';

interface Props {
  city: City;
  overlay?: boolean;
}
const { city, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/uslugi/', label: 'Услуги', sub: true },
  { href: '/ceny/', label: 'Цены' },
  { href: '/portfolio/', label: 'Проекты' },
  { href: '/proizvodstvo/', label: 'Производство' },
  { href: '/uslugi/dizajn-proekt/', label: 'Дизайн-проект' },
  { href: '/o-kompanii/', label: 'О нас' },
  { href: '/kontakty/', label: 'Контакты' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href) && href !== '/uslugi/');
---

<header class:list={['header', { 'header--overlay': overlay }]} data-header>
  <div class="container header-inner">
    <Logo />

    <nav class="nav" aria-label="Основное меню">
      <ul>
        {
          nav.map((n) => (
            <li class:list={[{ 'has-sub': n.sub }]}>
              <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
              {n.sub && (
                <div class="sub">
                  <ul>
                    {SERVICES.map((s) => (
                      <li>
                        <a href={cityServiceUrl(city, s.slug)}>
                          <span>{s.short}</span>
                          <small>от {new Intl.NumberFormat('ru-RU').format(s.priceFrom)} ₽/{s.unit}</small>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button class="city-btn" popovertarget="city-picker" aria-label={`${city.name} — выбрать город`}>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8"></path><circle cx="12" cy="10" r="2.6" fill="currentColor"></circle></svg>
        <span>{city.name}</span>
      </button>
      <a class="phone" href={`tel:${SITE.phoneHref}`}>
        <span class="phone-num">{SITE.phone}</span>
        <span class="phone-hours">{SITE.hours.label}</span>
      </a>
      <button class="btn btn--accent header-cta" data-lead="Бесплатный замер (шапка)">Бесплатный замер</button>
      <button class="burger" popovertarget="mobile-menu" aria-label="Открыть меню">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Выбор региона: нативный Popover API, без JS -->
<div id="city-picker" popover class="popover city-popover">
  <p class="eyebrow">Выберите город</p>
  <ul>
    {
      ACTIVE_CITIES.map((c) => (
        <li>
          <a href={cityBase(c)} aria-current={c.slug === city.slug ? 'true' : undefined}>
            <span>{c.name}</span>
            <small>{c.primary ? 'Основной офис и производство' : 'Выезд бригад из Архангельска'}</small>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="muted small">Скоро — другие города Северо-Запада. Нужен ремонт в вашем городе? <a href="/kontakty/">Напишите нам</a>.</p>
</div>

<div id="mobile-menu" popover class="popover mobile-menu">
  <div class="mm-head">
    <Logo />
    <button class="mm-close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Закрыть меню">✕</button>
  </div>
  <nav aria-label="Мобильное меню">
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/blog/">Журнал</a></li>
    </ul>
  </nav>
  <div class="mm-foot">
    <a class="btn btn--accent" href={`tel:${SITE.phoneHref}`}>Позвонить {SITE.phone}</a>
    <div class="mm-msg">
      <a class="btn btn--ghost" href={SITE.telegram} rel="noopener" target="_blank">Telegram</a>
      <a class="btn btn--ghost" href={SITE.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
    </div>
  </div>
</div>

<!-- Нижняя панель на мобильных -->
<nav class="mobile-bar" aria-label="Быстрая связь">
  <a href={`tel:${SITE.phoneHref}`} class="mb-item">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 7 7L16 14l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
    Звонок
  </a>
  <a href={SITE.telegram} class="mb-item" target="_blank" rel="noopener">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 18-7-3 16-6-5-3 3v-5l9-7-11 6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
    Написать
  </a>
  <button class="mb-cta" data-lead="Расчёт стоимости (моб. панель)">Рассчитать ремонт</button>
</nav>

<script>
  // Запасной вариант для браузеров без Popover API (iOS < 17, старые Android)
  if (!('popover' in HTMLElement.prototype)) {
    document.documentElement.classList.add('no-popover');
    const close = () => document.querySelectorAll('[popover].is-open').forEach((el) => el.classList.remove('is-open'));
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const btn = t.closest<HTMLElement>('[popovertarget]');
      if (btn) {
        const target = document.getElementById(btn.getAttribute('popovertarget')!);
        const action = btn.getAttribute('popovertargetaction');
        const open = target?.classList.contains('is-open');
        close();
        if (target && action !== 'hide' && !open) target.classList.add('is-open');
        return;
      }
      if (!t.closest('[popover]')) close();
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
  }

  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(244 241 236 / 0.72);
    backdrop-filter: saturate(1.4) blur(18px);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      background 0.3s;
  }

  /* Прозрачная шапка поверх фото: светлый текст до начала прокрутки */
  .header--overlay:not(:global(.is-scrolled)) {
    --ink: #fbf9f6;
    --line: rgb(255 255 255 / 0.32);
    --logo-fg: #fbf9f6;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: #fbf9f6;
  }

  .header--overlay:not(:global(.is-scrolled)) :global(.logo) {
    --logo-bg: #15130f;
  }

  .header--overlay:not(:global(.is-scrolled)) .nav > ul > li > a:hover,
  .header--overlay:not(:global(.is-scrolled)) .nav a[aria-current='page'] {
    background: rgb(255 255 255 / 0.14);
  }

  .header--overlay .sub ul {
    --ink: #15130f;
    color: #15130f;
  }

  .header--overlay:not(:global(.is-scrolled)) .phone-hours {
    color: rgb(251 249 246 / 0.7);
  }

  .header:global(.is-scrolled) {
    border-color: var(--line);
    background: rgb(244 241 236 / 0.9);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav {
    display: none;
  }

  .nav > ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav > ul > li {
    position: relative;
  }

  .nav > ul > li > a {
    display: block;
    padding: 10px 11px;
    white-space: nowrap;
    border-radius: 999px;
    font-size: 0.93rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nav > ul > li > a:hover,
  .nav a[aria-current='page'] {
    background: rgb(21 19 15 / 0.06);
  }

  .sub {
    position: absolute;
    top: 100%;
    left: -12px;
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: 0.25s var(--ease);
  }

  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sub ul {
    list-style: none;
    margin: 0;
    padding: 10px;
    width: 340px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgb(21 19 15 / 0.35);
  }

  .sub a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.94rem;
  }

  .sub a:hover {
    background: var(--paper);
  }

  .sub small {
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .city-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    font: 600 0.88rem var(--font-sans);
    color: inherit;
    cursor: pointer;
  }

  .city-btn:hover {
    border-color: var(--ink);
  }

  .phone {
    display: none;
    text-decoration: none;
    line-height: 1.2;
    text-align: right;
  }

  .phone-num {
    display: block;
    font-weight: 700;
    white-space: nowrap;
  }

  .phone-hours {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .header-cta {
    display: none;
    min-height: 46px;
    padding-inline: 20px;
  }

  .burger {
    width: 46px;
    height: 46px;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 18px;
    height: 1.6px;
    background: var(--ink);
  }

  @media (max-width: 560px) {
    .header-inner {
      gap: 10px;
    }

    .header-actions {
      gap: 8px;
    }

    .city-btn span {
      display: none;
    }

    .city-btn,
    .burger {
      width: 42px;
      height: 42px;
      padding: 0;
      justify-content: center;
    }

    :global(.header .logo-sub) {
      display: none;
    }
  }

  @media (max-width: 400px) {
    :global(.header .logo) {
      gap: 9px;
      min-width: 0;
      flex: 1 1 auto;
    }

    :global(.header .logo svg) {
      width: 34px;
      height: 34px;
    }

    :global(.header .logo-name) {
      font-size: 1.02rem;
      white-space: normal;
      line-height: 1.05;
    }
  }

  @media (min-width: 760px) {
    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1360px) {
    .nav {
      display: block;
    }

    .burger {
      display: none;
    }
  }

  @media (min-width: 1360px) and (max-width: 1539px) {
    :global(.header .logo-sub) {
      display: none;
    }

    .header-inner {
      gap: 16px;
    }
  }

  @media (min-width: 1700px) {
    .phone {
      display: block;
    }
  }

  /* Поповеры */
  .popover {
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
    color: var(--ink);
    padding: 24px;
    box-shadow: 0 40px 80px -30px rgb(21 19 15 / 0.45);
  }

  .popover::backdrop {
    background: rgb(21 19 15 / 0.35);
    backdrop-filter: blur(4px);
  }

  .city-popover {
    width: min(420px, calc(100vw - 32px));
    margin: auto;
  }

  .city-popover ul {
    list-style: none;
    padding: 0;
    margin: 14px 0;
    display: grid;
    gap: 8px;
  }

  .city-popover ul a {
    display: grid;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
  }

  .city-popover ul a span {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .city-popover ul a small {
    color: var(--muted);
  }

  .city-popover ul a:hover,
  .city-popover ul a[aria-current] {
    border-color: var(--accent);
    background: #fff;
  }

  .small {
    font-size: 0.86rem;
    margin: 0;
  }

  .mobile-menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: var(--paper);
    display: none;
    flex-direction: column;
    padding: 16px var(--gutter) 28px;
  }

  .mobile-menu:popover-open {
    display: flex;
  }

  :global(.no-popover) [popover] {
    display: none;
    position: fixed;
    z-index: 100;
  }

  :global(.no-popover) .city-popover:global(.is-open) {
    display: block;
    inset: 0;
    height: fit-content;
    box-shadow: 0 0 0 100vmax rgb(21 19 15 / 0.35);
  }

  :global(.no-popover) .mobile-menu:global(.is-open) {
    display: flex;
  }

  .mm-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .mm-head :global(.logo-sub) {
    display: none;
  }

  .mm-head :global(.logo) {
    min-width: 0;
    flex: 1 1 auto;
  }

  .mm-head :global(.logo-name) {
    white-space: normal;
  }

  .mm-close {
    flex: none;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    font-size: 1rem;
    cursor: pointer;
    color: var(--ink);
  }

  .mobile-menu nav ul {
    list-style: none;
    padding: 0;
    margin: 28px 0;
  }

  .mobile-menu nav a {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 7vw, 2.2rem);
    text-decoration: none;
  }

  .mm-foot {
    margin-top: auto;
    display: grid;
    gap: 10px;
  }

  .mm-msg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .mobile-bar {
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(31 29 25 / 0.92);
    backdrop-filter: blur(14px);
    color: var(--paper);
    box-shadow: 0 20px 40px -16px rgb(0 0 0 / 0.5);
  }

  .mb-item {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 6px 14px;
    font-size: 0.68rem;
    font-weight: 600;
    text-decoration: none;
  }

  .mb-cta {
    border: 0;
    border-radius: 999px;
    background: var(--accent-btn);
    color: #fff;
    font: 700 0.95rem var(--font-sans);
    cursor: pointer;
  }

  @media (min-width: 760px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
