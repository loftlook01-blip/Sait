---
const items = [
  'Фиксированная смета',
  'Собственный столярный цех',
  'Сварка и порошковая покраска',
  'Дизайн-проект',
  'Оплата по этапам',
  'Фотоотчёты каждый день',
  'Гарантия по договору',
  'Приёмка по чек-листу',
];
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {[...items, ...items].map((t) => <span>{t}<i>✦</i></span>)}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    padding: 22px 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    white-space: nowrap;
  }

  i {
    color: var(--accent);
    font-style: normal;
    font-size: 0.7em;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
