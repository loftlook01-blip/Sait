---
import Breadcrumbs from './Breadcrumbs.astro';
import Art from './Art.astro';
import type { ArtVariant } from './art';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs: { name: string; url: string }[];
  art?: ArtVariant;
}
const { title, eyebrow, lead, crumbs, art } = Astro.props;
---

<section class="ph">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class:list={['ph-grid', { 'has-art': art }]}>
      <div class="ph-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="h-display" set:html={title} />
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {
        art && (
          <div class="ph-art media">
            <Art variant={art} eager />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .ph {
    padding: clamp(24px, 4vw, 48px) 0 clamp(48px, 6vw, 80px);
  }

  .ph-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .has-art {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .ph-copy {
    display: grid;
    gap: 22px;
    animation: rise 0.8s var(--ease) both;
  }

  .h-display {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
  }

  .ph-art {
    aspect-ratio: 4 / 3.2;
    box-shadow: 0 40px 80px -40px rgb(21 19 15 / 0.45);
    animation: rise 1s 0.1s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
