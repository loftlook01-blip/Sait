---
/**
 * Изображение интерьера / производства.
 * По умолчанию берётся сгенерированная картинка из /public/images/art/<variant>.webp
 * (исходники сцен — scripts/art/scenes.mjs, пересобрать: npm run images).
 * Чтобы поставить реальную фотографию — передайте photo или замените файл с тем же именем.
 */
import { ART_LABELS, type ArtVariant } from './art';

interface Props {
  variant: ArtVariant;
  state?: 'after' | 'before';
  photo?: string;
  alt?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}

const { variant, state = 'after', photo, alt, class: cls = '', eager = false, sizes = '(min-width: 1000px) 50vw, 100vw' } = Astro.props;
const label = alt ?? (state === 'before' ? 'Объект до ремонта: черновая отделка' : ART_LABELS[variant]);
const name = state === 'before' ? 'before' : variant;
const src = photo ?? `/images/art/${name}.webp`;
const srcset = photo ? undefined : `/images/art/${name}-800.webp 800w, /images/art/${name}.webp 1600w`;
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={label}
  width="1600"
  height="1200"
  class={`art ${cls}`}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
