---
/**
 * Иллюстрация интерьера / производства.
 * Если передан photo (путь в /public/images/...), выводится фотография — иллюстрация служит заглушкой,
 * пока у компании нет собственных фото объектов.
 */
import { ART_LABELS, ROOM_VARIANTS, type ArtVariant } from './art';

interface Props {
  variant: ArtVariant;
  state?: 'after' | 'before';
  photo?: string;
  alt?: string;
  class?: string;
  eager?: boolean;
}

const { variant, state = 'after', photo, alt, class: cls = '', eager = false } = Astro.props;
const label = alt ?? (state === 'before' ? `Объект до ремонта: черновая отделка` : ART_LABELS[variant]);
const id = `a${Math.random().toString(36).slice(2, 8)}`;
const isRoom = ROOM_VARIANTS.includes(variant);
const raw = state === 'before';

// Палитры: «после» — тёплая, «до» — бетон
const P = raw
  ? { ceil: '#cfccc6', back: '#b9b5ae', left: '#a9a59e', right: '#b1ada6', floor1: '#9c978f', floor2: '#8b867e', line: '#7f7a73' }
  : variant === 'bath'
    ? { ceil: '#efebe4', back: '#d9d1c5', left: '#cbc2b4', right: '#d2c9bc', floor1: '#c9bfb1', floor2: '#b5aa9b', line: '#a89d8e' }
    : variant === 'office'
      ? { ceil: '#2b2a28', back: '#e6e2db', left: '#d6d1c9', right: '#dcd7cf', floor1: '#a7a39c', floor2: '#8f8b84', line: '#7e7a74' }
      : variant === 'house'
        ? { ceil: '#e9e1d4', back: '#efe8dd', left: '#e2d9cb', right: '#e7dfd2', floor1: '#a9774b', floor2: '#8a5d38', line: '#7a5130' }
        : { ceil: '#f3efe8', back: '#ebe4d8', left: '#ddd3c4', right: '#e4dccf', floor1: '#c09166', floor2: '#9c6f48', line: '#8b6340' };

const planks = Array.from({ length: 17 }, (_, i) => i * 50);
const vx = (x: number) => 400 + (x - 400) * 0.42;
---

{photo ? (
  <img src={photo} alt={label} class={`art ${cls}`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
) : (
  <svg class={`art ${cls}`} viewBox="0 0 800 600" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={`${id}f`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={P.floor2} />
        <stop offset="1" stop-color={P.floor1} />
      </linearGradient>
      <linearGradient id={`${id}w`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e9f0f2" />
        <stop offset="1" stop-color="#c9d7dc" />
      </linearGradient>
      <linearGradient id={`${id}l`} x1="0" y1="0" x2="1" y2="0.6">
        <stop offset="0" stop-color="#fff" stop-opacity={raw ? 0.18 : 0.42} />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <radialGradient id={`${id}g`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#ffd9a8" stop-opacity="0.85" />
        <stop offset="1" stop-color="#ffd9a8" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`${id}d`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d1b18" />
        <stop offset="1" stop-color="#2c2925" />
      </linearGradient>
      <pattern id={`${id}grid`} width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M40 0H0V40" fill="none" stroke="#c98b5b" stroke-opacity="0.12" stroke-width="1" />
      </pattern>
    </defs>

    {isRoom && (
      <g>
        {/* Каркас комнаты */}
        <polygon points="0,0 800,0 620,110 180,110" fill={P.ceil} />
        <polygon points="0,0 180,110 180,400 0,600" fill={P.left} />
        <polygon points="800,0 620,110 620,400 800,600" fill={P.right} />
        <rect x="180" y="110" width="440" height="290" fill={P.back} />
        <polygon points="0,600 800,600 620,400 180,400" fill={`url(#${id}f)`} />
        {variant !== 'bath' && planks.map((x) => <line x1={x} y1="600" x2={vx(x)} y2="400" stroke={P.line} stroke-opacity={raw ? 0.15 : 0.35} stroke-width="1.2" />)}
        {variant === 'bath' && !raw && [430, 470, 520, 580].map((y) => <line x1={400 - (y - 255) * 1.16} y1={y} x2={400 + (y - 255) * 1.16} y2={y} stroke={P.line} stroke-opacity="0.2" />)}
        {/* Окно на левой стене и свет */}
        <polygon points="40,80 140,128 140,330 40,380" fill={`url(#${id}w)`} stroke={raw ? '#8e8a83' : '#f7f3ec'} stroke-width="6" />
        <line x1="90" y1="104" x2="90" y2="355" stroke={raw ? '#8e8a83' : '#f7f3ec'} stroke-width="4" />
        <polygon points="140,330 40,380 330,600 600,600" fill={`url(#${id}l)`} />
        {!raw && <polygon points="140,128 140,330 40,380 40,80" fill="#fff" fill-opacity="0.12" />}
        {/* Плинтус */}
        {!raw && <line x1="180" y1="400" x2="620" y2="400" stroke="#fff" stroke-opacity="0.5" stroke-width="2" />}
      </g>
    )}

    {/* ───────── ДО: черновая ───────── */}
    {isRoom && raw && (
      <g>
        {[230, 300, 370, 440, 510, 580].map((x) => <line x1={x} y1="118" x2={x} y2="396" stroke="#8d8982" stroke-width="3" />)}
        <path d="M400 110 V170" stroke="#3a3632" stroke-width="2" />
        <circle cx="400" cy="178" r="9" fill="#efe6c8" />
        <path d="M620 250 C 650 260, 700 230, 760 270" stroke="#c0392b" stroke-width="3" fill="none" />
        <path d="M620 262 C 660 280, 690 250, 770 300" stroke="#e1b12c" stroke-width="3" fill="none" />
        {/* стремянка */}
        <g stroke="#6d6a64" stroke-width="7" stroke-linecap="round">
          <line x1="520" y1="560" x2="565" y2="330" />
          <line x1="610" y1="560" x2="565" y2="330" />
          <line x1="530" y1="505" x2="598" y2="505" />
          <line x1="541" y1="450" x2="588" y2="450" />
          <line x1="552" y1="395" x2="578" y2="395" />
        </g>
        {/* ведро и мешки */}
        <path d="M250 520 h70 l-8 62 h-54z" fill="#e5e1da" />
        <ellipse cx="285" cy="520" rx="35" ry="8" fill="#cfcac2" />
        <rect x="330" y="540" width="110" height="46" rx="10" fill="#d8cfbd" />
        <rect x="350" y="515" width="100" height="40" rx="10" fill="#cdc3af" />
      </g>
    )}

    {/* ───────── Гостиная ───────── */}
    {variant === 'living' && !raw && (
      <g>
        {/* панели из дуба на правой стене */}
        {[0, 1, 2, 3, 4].map((i) => (
          <polygon points={`${620 + i * 36},${110 - i * 22} ${656 + i * 36},${88 - i * 22} ${656 + i * 36},${422 + i * 22} ${620 + i * 36},${400 + i * 22}`} fill={i % 2 ? '#b98a5f' : '#c49a70'} />
        ))}
        {/* картина */}
        <rect x="330" y="150" width="140" height="100" fill="#f7f3ec" stroke="#2a2723" stroke-width="4" />
        <circle cx="400" cy="200" r="28" fill="#b6774b" />
        <rect x="372" y="215" width="56" height="20" fill="#2f4a43" />
        {/* диван */}
        <rect x="230" y="300" width="340" height="70" rx="18" fill="#d9cfc0" />
        <rect x="210" y="330" width="380" height="80" rx="22" fill="#cbbfae" />
        <rect x="250" y="320" width="140" height="40" rx="14" fill="#e3d9cb" />
        <rect x="410" y="320" width="140" height="40" rx="14" fill="#e3d9cb" />
        <rect x="285" y="300" width="60" height="45" rx="10" fill="#2f4a43" />
        <line x1="230" y1="410" x2="230" y2="425" stroke="#2a2723" stroke-width="5" />
        <line x1="570" y1="410" x2="570" y2="425" stroke="#2a2723" stroke-width="5" />
        {/* ковёр и столик */}
        <ellipse cx="400" cy="500" rx="260" ry="55" fill="#e8e0d3" />
        <ellipse cx="400" cy="470" rx="95" ry="22" fill="#2a2723" />
        <rect x="396" y="470" width="8" height="45" fill="#2a2723" />
        <ellipse cx="400" cy="515" rx="40" ry="8" fill="#2a2723" />
        <rect x="370" y="448" width="28" height="18" rx="3" fill="#b6774b" />
        {/* торшер-подвес */}
        <line x1="470" y1="0" x2="470" y2="140" stroke="#2a2723" stroke-width="2" />
        <path d="M440 165 a30 26 0 0 1 60 0z" fill="#2a2723" />
        <circle cx="470" cy="175" r="70" fill={`url(#${id}g)`} />
        {/* растение */}
        <rect x="150" y="440" width="50" height="60" rx="6" fill="#efe8dc" />
        <path d="M175 440 C 150 380, 120 360, 110 320 M175 440 C 180 380, 200 340, 230 310 M175 440 C 170 400, 160 360, 170 300" stroke="#2f4a43" stroke-width="10" stroke-linecap="round" fill="none" />
      </g>
    )}

    {/* ───────── Кухня-лофт ───────── */}
    {variant === 'kitchen' && !raw && (
      <g>
        {/* кирпич на задней стене */}
        {Array.from({ length: 8 }, (_, r) => (
          Array.from({ length: 9 }, (_, c) => (
            <rect x={180 + c * 50 + (r % 2 ? 25 : 0) - 25} y={112 + r * 18} width="46" height="14" fill="#b4826a" fill-opacity="0.35" />
          ))
        ))}
        {/* верхние шкафы */}
        <rect x="200" y="140" width="250" height="70" fill="#2a2723" />
        <line x1="283" y1="140" x2="283" y2="210" stroke="#3d3934" stroke-width="2" />
        <line x1="366" y1="140" x2="366" y2="210" stroke="#3d3934" stroke-width="2" />
        <rect x="200" y="210" width="250" height="6" fill="#ffcf96" fill-opacity="0.7" />
        {/* нижние шкафы и столешница */}
        <rect x="200" y="290" width="400" height="16" fill="#c49a70" />
        <rect x="200" y="306" width="400" height="94" fill="#2a2723" />
        {[280, 360, 440, 520].map((x) => <line x1={x} y1="310" x2={x} y2="398" stroke="#3d3934" stroke-width="2" />)}
        <rect x="470" y="140" width="110" height="150" fill="#d8d3cb" />
        <rect x="485" y="158" width="80" height="50" fill="#1d1b18" />
        {/* остров */}
        <rect x="250" y="430" width="300" height="22" fill="#c49a70" />
        <rect x="265" y="452" width="270" height="110" fill="#33302b" />
        <rect x="290" y="562" width="10" height="20" fill="#1d1b18" />
        <rect x="500" y="562" width="10" height="20" fill="#1d1b18" />
        {/* табуреты */}
        {[300, 500].map((x) => (
          <g>
            <rect x={x - 22} y="470" width="44" height="10" rx="3" fill="#b6774b" />
            <line x1={x - 15} y1="480" x2={x - 22} y2="590" stroke="#1d1b18" stroke-width="4" />
            <line x1={x + 15} y1="480" x2={x + 22} y2="590" stroke="#1d1b18" stroke-width="4" />
          </g>
        ))}
        {/* подвесы */}
        {[330, 400, 470].map((x) => (
          <g>
            <line x1={x} y1="0" x2={x} y2="300" stroke="#1d1b18" stroke-width="2" />
            <path d={`M${x - 16} 318 a16 18 0 0 1 32 0z`} fill="#1d1b18" />
            <circle cx={x} cy="330" r="45" fill={`url(#${id}g)`} />
          </g>
        ))}
        {/* металлическая перегородка справа */}
        <polygon points="640,98 760,24 760,576 640,412" fill="#c9d7dc" fill-opacity="0.35" stroke="#1d1b18" stroke-width="7" />
        {[0.25, 0.5, 0.75].map((t) => <line x1="640" y1={98 + (412 - 98) * t} x2="760" y2={24 + (576 - 24) * t} stroke="#1d1b18" stroke-width="5" />)}
        <line x1="700" y1="61" x2="700" y2="494" stroke="#1d1b18" stroke-width="5" />
      </g>
    )}

    {/* ───────── Ванная ───────── */}
    {variant === 'bath' && !raw && (
      <g>
        <rect x="180" y="110" width="440" height="290" fill="#cfc6b8" fill-opacity="0.35" />
        {/* ниша с подсветкой */}
        <rect x="470" y="170" width="110" height="70" fill="#bdb2a3" />
        <rect x="470" y="170" width="110" height="5" fill="#ffd9a8" />
        <rect x="470" y="232" width="110" height="10" fill="#b98a5f" />
        <rect x="490" y="196" width="18" height="36" rx="4" fill="#2f4a43" />
        <rect x="518" y="208" width="14" height="24" rx="4" fill="#f4efe7" />
        {/* круглое зеркало и тумба */}
        <circle cx="300" cy="200" r="58" fill="#dbe5e8" stroke="#2a2723" stroke-width="4" />
        <circle cx="300" cy="200" r="70" fill={`url(#${id}g)`} opacity="0.5" />
        <rect x="235" y="290" width="130" height="40" fill="#b98a5f" />
        <ellipse cx="300" cy="290" rx="40" ry="8" fill="#f7f4ee" />
        <path d="M300 268 v14 h10" stroke="#2a2723" stroke-width="4" fill="none" />
        {/* ванна */}
        <path d="M250 430 h330 c0 70 -40 110 -110 110 h-110 c-70 0 -110 -40 -110 -110z" fill="#f7f4ee" />
        <ellipse cx="415" cy="430" rx="165" ry="18" fill="#e6e0d6" />
        <path d="M570 430 v-80 h-30" stroke="#2a2723" stroke-width="5" fill="none" />
        {/* полотенцесушитель */}
        <g stroke="#2f4a43" stroke-width="6">
          <line x1="660" y1="150" x2="660" y2="360" />
          <line x1="720" y1="130" x2="720" y2="390" />
          {[180, 230, 280, 330].map((y) => <line x1="660" y1={y} x2="720" y2={y - 12} />)}
        </g>
        <rect x="665" y="220" width="50" height="90" fill="#e8dfd2" />
      </g>
    )}

    {/* ───────── Спальня ───────── */}
    {variant === 'bedroom' && !raw && (
      <g>
        {/* панели изголовья */}
        {Array.from({ length: 11 }, (_, i) => <rect x={190 + i * 39} y="170" width="35" height="160" rx="10" fill="#cdbfae" />)}
        {/* бра */}
        {[215, 585].map((x) => (
          <g>
            <circle cx={x} cy="200" r="10" fill="#2a2723" />
            <circle cx={x} cy="205" r="50" fill={`url(#${id}g)`} />
          </g>
        ))}
        {/* кровать */}
        <rect x="260" y="300" width="280" height="40" rx="10" fill="#f4efe7" />
        <rect x="290" y="285" width="100" height="30" rx="10" fill="#fbf8f3" />
        <rect x="410" y="285" width="100" height="30" rx="10" fill="#fbf8f3" />
        <polygon points="240,340 560,340 610,470 190,470" fill="#e5dbcd" />
        <polygon points="300,370 600,370 640,470 250,470" fill="#2f4a43" fill-opacity="0.85" />
        <rect x="190" y="470" width="450" height="30" fill="#b98a5f" />
        {/* тумбы */}
        <rect x="185" y="330" width="60" height="70" fill="#b98a5f" />
        <rect x="555" y="330" width="60" height="70" fill="#b98a5f" />
        {/* шторы */}
        <polygon points="20,40 60,60 70,420 15,450" fill="#d8cdbd" />
        <polygon points="130,110 160,125 165,350 125,370" fill="#d8cdbd" />
        {/* шкаф справа */}
        <polygon points="640,98 790,6 790,594 640,412" fill="#e9e1d4" />
        <line x1="715" y1="52" x2="715" y2="503" stroke="#cbbfae" stroke-width="3" />
      </g>
    )}

    {/* ───────── Офис ───────── */}
    {variant === 'office' && !raw && (
      <g>
        {/* акустический потолок */}
        {[0.2, 0.45, 0.7].map((t) => <rect x={200 + 200 * t} y={30 + 60 * t} width="120" height="10" rx="5" fill="#ffd9a8" fill-opacity="0.8" />)}
        {/* стеклянная переговорная */}
        <rect x="200" y="130" width="400" height="270" fill="#c9d7dc" fill-opacity="0.45" stroke="#1d1b18" stroke-width="7" />
        {[300, 400, 500].map((x) => <line x1={x} y1="130" x2={x} y2="400" stroke="#1d1b18" stroke-width="5" />)}
        <rect x="260" y="290" width="280" height="14" fill="#c49a70" />
        {[280, 340, 400, 460, 520].map((x) => <rect x={x - 14} y="304" width="28" height="40" rx="6" fill="#2f4a43" />)}
        <rect x="350" y="170" width="100" height="70" fill="#f7f3ec" stroke="#1d1b18" stroke-width="3" />
        {/* стол open-space */}
        <rect x="150" y="470" width="500" height="18" fill="#c49a70" />
        <line x1="180" y1="488" x2="180" y2="590" stroke="#1d1b18" stroke-width="6" />
        <line x1="620" y1="488" x2="620" y2="590" stroke="#1d1b18" stroke-width="6" />
        {[260, 400, 540].map((x) => (
          <g>
            <rect x={x - 40} y="420" width="80" height="50" rx="4" fill="#1d1b18" />
            <rect x={x - 6} y="465" width="12" height="6" fill="#1d1b18" />
          </g>
        ))}
        {/* растения */}
        <rect x="660" y="430" width="60" height="70" fill="#1d1b18" />
        <circle cx="690" cy="400" r="45" fill="#2f4a43" />
      </g>
    )}

    {/* ───────── Дом ───────── */}
    {variant === 'house' && !raw && (
      <g>
        {/* балки потолка */}
        {[0.25, 0.5, 0.75].map((t) => <polygon points={`${800 * t - 30},0 ${800 * t + 30},0 ${180 + 440 * t + 8},110 ${180 + 440 * t - 8},110`} fill="#8a5d38" />)}
        <rect x="180" y="104" width="440" height="10" fill="#8a5d38" />
        {/* бревенчатая текстура */}
        {Array.from({ length: 9 }, (_, i) => <line x1="180" y1={140 + i * 30} x2="620" y2={140 + i * 30} stroke="#c9b79c" stroke-width="2" />)}
        {/* лестница на металлическом косоуре */}
        <line x1="420" y1="400" x2="610" y2="140" stroke="#1d1b18" stroke-width="10" />
        {Array.from({ length: 9 }, (_, i) => <rect x={420 + i * 21 - 18} y={386 - i * 29} width="62" height="10" fill="#b57f4f" />)}
        <line x1="440" y1="340" x2="630" y2="80" stroke="#1d1b18" stroke-width="4" />
        {Array.from({ length: 7 }, (_, i) => <line x1={450 + i * 27} y1={326 - i * 37} x2={450 + i * 27} y2={386 - i * 37} stroke="#1d1b18" stroke-width="3" />)}
        {/* камин */}
        <rect x="220" y="250" width="150" height="150" fill="#2a2723" />
        <rect x="245" y="300" width="100" height="70" fill="#1d1b18" />
        <circle cx="295" cy="345" r="60" fill={`url(#${id}g)`} />
        <path d="M280 365 q15 -40 15 -50 q15 20 10 50z" fill="#e29a5a" />
        {/* кресло */}
        <rect x="150" y="440" width="150" height="90" rx="20" fill="#2f4a43" />
        <rect x="165" y="420" width="120" height="50" rx="16" fill="#3b5a51" />
        <ellipse cx="420" cy="540" rx="200" ry="40" fill="#e8dfd2" fill-opacity="0.6" />
      </g>
    )}

    {/* ───────── Чертёж ───────── */}
    {variant === 'blueprint' && (
      <g>
        <rect width="800" height="600" fill={`url(#${id}d)`} />
        <rect width="800" height="600" fill={`url(#${id}grid)`} />
        <g fill="none" stroke="#efe6d8" stroke-width="6" stroke-linejoin="round">
          <path d="M120 100 H680 V500 H120 Z" />
          <path d="M380 100 V260 M380 330 V500 M120 300 H300 M350 300 H380 M520 100 V200 M520 260 V320 H680" />
        </g>
        <g fill="none" stroke="#c98b5b" stroke-width="2.5">
          {/* мебель контуром */}
          <rect x="420" y="360" width="200" height="80" rx="12" />
          <rect x="450" y="380" width="60" height="40" rx="6" />
          <rect x="160" y="140" width="150" height="110" rx="8" />
          <path d="M160 170 H310" />
          <rect x="560" y="130" width="90" height="40" />
          <circle cx="600" cy="230" r="22" />
          <rect x="150" y="360" width="200" height="30" />
          <rect x="150" y="430" width="70" height="40" />
          <path d="M380 260 a70 70 0 0 1 70 70" stroke-dasharray="6 6" />
          <path d="M300 300 a50 50 0 0 0 50 -50" stroke-dasharray="6 6" />
        </g>
        {/* размерные линии */}
        <g stroke="#efe6d8" stroke-opacity="0.6" stroke-width="1.5">
          <line x1="120" y1="70" x2="680" y2="70" />
          <line x1="120" y1="62" x2="120" y2="78" />
          <line x1="680" y1="62" x2="680" y2="78" />
          <line x1="710" y1="100" x2="710" y2="500" />
          <line x1="702" y1="100" x2="718" y2="100" />
          <line x1="702" y1="500" x2="718" y2="500" />
        </g>
        <g fill="#efe6d8" font-family="ui-monospace, monospace" font-size="16">
          <text x="370" y="60">11 200</text>
          <text x="722" y="305" transform="rotate(90 722 305)">8 000</text>
          <text x="190" y="285" fill="#c98b5b">Спальня 16,4 м²</text>
          <text x="430" y="300" fill="#c98b5b">Гостиная 28,1 м²</text>
          <text x="540" y="300" fill="#c98b5b" font-size="13">С/у 5,2</text>
          <text x="160" y="490" fill="#c98b5b">Кухня 12,7 м²</text>
        </g>
      </g>
    )}

    {/* ───────── Цеха ───────── */}
    {variant.startsWith('workshop') && (
      <g>
        <rect width="800" height="600" fill="#22201c" />
        <polygon points="0,420 800,420 800,600 0,600" fill="#2e2b26" />
        {/* фермы потолка */}
        <g stroke="#3a3631" stroke-width="5" fill="none">
          <path d="M0 60 H800 M0 120 H800" />
          {Array.from({ length: 10 }, (_, i) => <path d={`M${i * 80} 60 L${i * 80 + 40} 120 L${i * 80 + 80} 60`} />)}
        </g>
        {/* световые фонари */}
        {[160, 400, 640].map((x) => (
          <g>
            <rect x={x - 50} y="128" width="100" height="8" fill="#f2e3c6" />
            <polygon points={`${x - 50},136 ${x + 50},136 ${x + 140},420 ${x - 140},420`} fill="#f2e3c6" fill-opacity="0.05" />
          </g>
        ))}
      </g>
    )}
    {variant === 'workshop-wood' && (
      <g>
        {/* стопка плит */}
        {Array.from({ length: 7 }, (_, i) => <rect x="70" y={360 - i * 22} width="230" height="18" fill={i % 2 ? '#d2b48c' : '#c4a079'} />)}
        {/* форматно-раскроечный станок */}
        <rect x="340" y="380" width="380" height="24" fill="#d7d2c8" />
        <rect x="360" y="404" width="40" height="120" fill="#4a463f" />
        <rect x="660" y="404" width="40" height="120" fill="#4a463f" />
        <rect x="400" y="350" width="260" height="30" fill="#e2c49c" />
        <circle cx="560" cy="380" r="40" fill="none" stroke="#b6774b" stroke-width="5" stroke-dasharray="6 5" />
        <rect x="540" y="250" width="40" height="90" fill="#b6774b" />
        <rect x="520" y="230" width="80" height="24" fill="#3a3631" />
        {/* опилки */}
        {Array.from({ length: 26 }, (_, i) => <circle cx={600 + ((i * 37) % 120)} cy={330 - ((i * 23) % 60)} r={1.5 + (i % 3)} fill="#e2c49c" fill-opacity="0.8" />)}
        {/* фасады на стене */}
        {[0, 1, 2].map((i) => <rect x={110 + i * 80} y="170" width="60" height="120" fill="#b98a5f" stroke="#e2c49c" stroke-width="3" />)}
      </g>
    )}
    {variant === 'workshop-metal' && (
      <g>
        {/* сварочный стол */}
        <rect x="200" y="400" width="420" height="20" fill="#5b5750" />
        <rect x="220" y="420" width="20" height="110" fill="#3a3631" />
        <rect x="580" y="420" width="20" height="110" fill="#3a3631" />
        {/* каркас изделия */}
        <g stroke="#9a968e" stroke-width="10" fill="none">
          <rect x="260" y="230" width="300" height="170" />
          <line x1="410" y1="230" x2="410" y2="400" />
          <line x1="260" y1="315" x2="560" y2="315" />
        </g>
        {/* искры */}
        <circle cx="410" cy="315" r="90" fill="#ffb15e" fill-opacity="0.18" />
        <circle cx="410" cy="315" r="14" fill="#fff4dc" />
        {Array.from({ length: 22 }, (_, i) => {
          const a = (i / 22) * Math.PI * 2;
          const r = 40 + ((i * 17) % 60);
          return <line x1={410 + Math.cos(a) * 18} y1={315 + Math.sin(a) * 18} x2={410 + Math.cos(a) * r} y2={315 + Math.sin(a) * r + 20} stroke="#ffc46b" stroke-width="2.5" stroke-linecap="round" />;
        })}
        {/* профиль на стеллаже */}
        {[0, 1, 2, 3].map((i) => <rect x="660" y={200 + i * 30} width="120" height="10" fill="#7d7972" />)}
      </g>
    )}
    {variant === 'workshop-powder' && (
      <g>
        {/* камера */}
        <rect x="150" y="150" width="500" height="320" fill="#2f2c27" stroke="#4a463f" stroke-width="6" />
        <rect x="170" y="170" width="460" height="280" fill="#3b3833" />
        <line x1="170" y1="200" x2="630" y2="200" stroke="#7d7972" stroke-width="5" />
        {/* подвешенные изделия в цветах RAL */}
        {[
          ['#1d1b18', 210],
          ['#b6774b', 320],
          ['#2f4a43', 430],
          ['#e9e4dc', 540],
        ].map(([c, x]) => (
          <g>
            <line x1={x as number} y1="200" x2={x as number} y2="240" stroke="#9a968e" stroke-width="2" />
            <rect x={(x as number) - 35} y="240" width="70" height="150" fill={c as string} />
          </g>
        ))}
        {/* облако порошка */}
        <ellipse cx="480" cy="330" rx="120" ry="60" fill="#b6774b" fill-opacity="0.18" />
        {Array.from({ length: 40 }, (_, i) => <circle cx={380 + ((i * 41) % 200)} cy={290 + ((i * 29) % 90)} r={1.5 + (i % 2)} fill="#d79a6c" fill-opacity="0.7" />)}
        {/* пистолет */}
        <path d="M640 360 l-80 -18 l6 -16 l84 14z" fill="#d7d2c8" />
        <rect x="640" y="356" width="16" height="50" fill="#9a968e" transform="rotate(10 640 356)" />
        {/* палитра RAL */}
        {['#1d1b18', '#3b3833', '#b6774b', '#c49a70', '#2f4a43', '#e9e4dc'].map((c, i) => <rect x={150 + i * 40} y="500" width="34" height="34" fill={c} />)}
      </g>
    )}
  </svg>
)}

<style>
  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
