---
/**
 * Первый экран: визуализация на всю ширину, шапка поверх неё (Base: overlayHeader).
 * Изображение — /public/images/art/hero.webp (16:9), при замене фото держите главное справа.
 */
import { SITE, guaranteeLabel } from '../data/site';
import type { City } from '../data/cities';

interface Props {
  city: City;
}
const { city } = Astro.props;
const { checklistPoints } = SITE.promises;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img
      class="hero-img"
      src="/images/art/hero.webp"
      srcset="/images/art/hero-1200.webp 1200w, /images/art/hero.webp 1920w"
      sizes="100vw"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="container hero-inner">
    <div class="copy">
      <h1 class="h1" id="hero-title">
        <span class="eyebrow">Ремонт под ключ {city.in}</span>
        <span class="h-display">Ремонт, который делают <em>мастера</em>, а&nbsp;не&nbsp;посредники</span>
      </h1>
      <p class="lead">
        Дизайн-проект, фиксированная смета и&nbsp;собственный цех: столярное и сварочное производство с порошковой покраской. Мебель, двери и металл делаем сами — точно по размерам вашего объекта.
      </p>
      <div class="ctas">
        <a href="/ceny/#calc" class="btn btn--accent">Рассчитать стоимость <span class="arrow">→</span></a>
        <button class="btn btn--glass" data-lead="Бесплатный замер (hero)">Записаться на бесплатный замер</button>
      </div>
    </div>

    <ul class="facts" aria-label="Наши обязательства">
      <li><b>{guaranteeLabel()}</b><span>гарантии по договору</span></li>
      <li><b>{checklistPoints}+</b><span>пунктов приёмки — <a href="/chek-list-priemki/">чек-лист</a></span></li>
      <li><b>0 ₽</b><span>замер и предварительная смета</span></li>
      <li><b>3 цеха</b><span>столярный, сварочный, порошковая покраска</span></li>
    </ul>
  </div>

  <p class="caption">Визуализация студии · гостиная 64 м², Майская горка</p>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(640px, 100svh, 920px);
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + 48px) 0 clamp(28px, 4vw, 48px);
    color: #fbf9f6;
    overflow: hidden;
    background: #2a2723;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
    animation: hero-in 1.6s var(--ease) both;
  }

  /* Затемнение: сверху — под шапку, снизу и слева — под текст */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(15 13 11 / 0.55) 0%, rgb(15 13 11 / 0) 22%),
      linear-gradient(90deg, rgb(15 13 11 / 0.72) 0%, rgb(15 13 11 / 0.35) 45%, rgb(15 13 11 / 0) 70%),
      linear-gradient(0deg, rgb(15 13 11 / 0.7) 0%, rgb(15 13 11 / 0) 45%);
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-img {
        animation:
          hero-in 1.6s var(--ease) both,
          hero-par linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 100vh;
      }
    }
  }

  @keyframes hero-in {
    from {
      transform: scale(1.08);
      filter: brightness(0.7);
    }
  }

  @keyframes hero-par {
    to {
      transform: translateY(12%) scale(1.06);
    }
  }

  .hero-inner {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  .copy {
    display: grid;
    gap: 24px;
    max-width: 820px;
    animation: rise 1s 0.15s var(--ease) both;
  }

  .h1 {
    display: grid;
    gap: 22px;
  }

  .h1 .eyebrow {
    color: #e2b48c;
  }

  .h1 em {
    color: #e2b48c;
  }

  .h-display {
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }

  .lead {
    color: rgb(251 249 246 / 0.86);
    max-width: 58ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 560px) {
    .ctas .btn {
      width: 100%;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgb(255 255 255 / 0.14);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    animation: rise 1s 0.35s var(--ease) both;
  }

  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .facts li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: clamp(14px, 2vw, 22px) clamp(14px, 2vw, 24px);
    background: rgb(20 18 15 / 0.38);
  }

  .facts b {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1;
  }

  .facts span {
    font-size: 0.82rem;
    line-height: 1.35;
    color: rgb(251 249 246 / 0.78);
  }

  .facts a {
    color: #e2b48c;
  }

  .caption {
    position: absolute;
    right: max(16px, env(safe-area-inset-right, 0px));
    top: calc(var(--header-h) + 14px);
    margin: 0;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(20 18 15 / 0.35);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgb(251 249 246 / 0.8);
  }

  @media (max-width: 760px) {
    .caption {
      display: none;
    }

    .hero-img {
      object-position: 70% 50%;
    }

    .hero-media::after {
      background:
        linear-gradient(180deg, rgb(15 13 11 / 0.6) 0%, rgb(15 13 11 / 0.15) 30%),
        linear-gradient(0deg, rgb(15 13 11 / 0.85) 0%, rgb(15 13 11 / 0.35) 60%);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
