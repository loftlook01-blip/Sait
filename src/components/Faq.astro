---
interface Props {
  items: { q: string; a: string }[];
  /** Имя группы: внутри группы открыт только один ответ */
  group?: string;
  /** Раскрыть первый вопрос */
  openFirst?: boolean;
}
const { items, group = 'faq', openFirst = true } = Astro.props;
---

<div class="faq">
  {
    items.map((i, n) => (
      <details name={group} open={openFirst && n === 0}>
        <summary>
          <span>{i.q}</span>
          <i aria-hidden="true" />
        </summary>
        <div class="a">
          <p>{i.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 600;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  i {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: 0.3s var(--ease);
  }

  i::before,
  i::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.6px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: 0.3s var(--ease);
  }

  i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] i {
    background: var(--ink);
    color: var(--paper);
  }

  details[open] i::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .a {
    padding: 0 64px 26px 0;
    color: var(--muted);
    max-width: 80ch;
  }

  .a p {
    margin: 0;
  }

  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.4s var(--ease),
        content-visibility 0.4s allow-discrete;
    }

    details[open]::details-content {
      height: auto;
    }
  }
</style>
