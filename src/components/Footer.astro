---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
import { ACTIVE_CITIES, cityBase, cityServiceUrl, type City } from '../data/cities';
import { SERVICES } from '../data/services';
import { FLATS } from '../data/flats';

interface Props {
  city: City;
}
const { city } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Logo light />
        <p class="claim serif">Ремонт, за который <em>не стыдно</em> через десять лет.</p>
        <div class="socials">
          <a href={SITE.telegram} target="_blank" rel="noopener">Telegram</a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          <a href={SITE.vk} target="_blank" rel="noopener">ВКонтакте</a>
        </div>
      </div>

      <nav class="cols" aria-label="Карта сайта">
        <div>
          <p class="col-title">Услуги {city.in}</p>
          <ul>{SERVICES.map((s) => <li><a href={cityServiceUrl(city, s.slug)}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="col-title">Ремонт квартир</p>
          <ul>{FLATS.map((f) => <li><a href={`/remont/${f.slug}/`}>{f.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="col-title">Компания</p>
          <ul>
            <li><a href="/o-kompanii/">О компании</a></li>
            <li><a href="/proizvodstvo/">Производство</a></li>
            <li><a href="/portfolio/">Проекты</a></li>
            <li><a href="/ceny/">Цены и калькулятор</a></li>
            <li><a href="/garantii/">Гарантии и договор</a></li>
            <li><a href="/smeta/">Пример сметы</a></li>
            <li><a href="/voprosy/">Вопросы и ответы</a></li>
            <li><a href="/blog/">Журнал</a></li>
            <li><a href="/kontakty/">Контакты</a></li>
          </ul>
        </div>
        <div>
          <p class="col-title">Города</p>
          <ul>{ACTIVE_CITIES.map((c) => <li><a href={cityBase(c)}>Ремонт {c.in}</a></li>)}</ul>
          <p class="col-title" style="margin-top:28px">Контакты</p>
          <ul>
            <li><a class="big" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li class="muted">{SITE.hours.label}</li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} {SITE.legalName}{SITE.inn && ` · ИНН ${SITE.inn}`}{SITE.ogrn && ` · ОГРН ${SITE.ogrn}`}</p>
      <p>
        <a href="/politika-konfidencialnosti/">Политика конфиденциальности</a>
      </p>
      <p class="muted">Цены на сайте носят информационный характер и не являются публичной офертой (ст. 437 ГК РФ).</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(64px, 8vw, 110px) 0 calc(28px + 84px);
  }

  @media (min-width: 760px) {
    .footer {
      padding-bottom: 32px;
    }
  }

  .top {
    display: grid;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line-dark);
  }

  @media (min-width: 1000px) {
    .top {
      grid-template-columns: 1fr 1.6fr;
    }
  }

  .claim {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.15;
    margin: 28px 0;
    max-width: 18ch;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .socials a {
    padding: 9px 16px;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .socials a:hover {
    border-color: var(--accent);
  }

  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .col-title {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-dark);
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 9px;
  }

  ul a {
    text-decoration: none;
    opacity: 0.85;
  }

  ul a:hover {
    opacity: 1;
    color: var(--accent);
  }

  .big {
    font-size: 1.15rem;
    font-weight: 700;
    opacity: 1 !important;
  }

  .muted {
    color: var(--muted-dark);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-top: 28px;
    font-size: 0.82rem;
    color: var(--muted-dark);
  }

  .bottom p {
    margin: 0;
  }
</style>
