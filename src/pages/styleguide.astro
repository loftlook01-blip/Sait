---
/**
 * Дизайн-система сайта: цвета, типографика, кнопки, компоненты.
 * Служебная страница для дизайнера и разработчика — закрыта от индексации и не попадает в sitemap.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Art from '../components/Art.astro';
import Packages from '../components/Packages.astro';
import Faq from '../components/Faq.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import LeadForm from '../components/LeadForm.astro';
import { ART_LABELS, type ArtVariant } from '../components/art';

const colors = [
  ['--paper', '#f4f1ec', 'Фон страницы'],
  ['--paper-2', '#ebe6de', 'Фон чередующихся секций'],
  ['--card', '#fbf9f6', 'Карточки, поля'],
  ['--ink', '#15130f', 'Основной текст, тёмные кнопки, футер'],
  ['--graphite', '#1f1d19', 'Тёмные секции'],
  ['--graphite-2', '#2a2723', 'Карточки на тёмном'],
  ['--muted', '#675f56', 'Второстепенный текст на светлом'],
  ['--muted-dark', '#a59d92', 'Второстепенный текст на тёмном'],
  ['--accent', '#a3653b', 'Медь: акценты и кнопки на светлом'],
  ['--accent (тёмный фон)', '#c08a5f', 'Медь: акценты на тёмном'],
  ['--accent-ink', '#8a5330', 'Медь: мелкий текст, наведение'],
  ['--accent-soft', '#e9d5c3', 'Медь: подложки иконок'],
  ['--pine', '#2f4a43', 'Северный зелёный: детали иллюстраций'],
];
const type = [
  ['h-display', 'Заголовок страницы (H1)', 'Playfair Display 400 · 32→90 px', 'Ремонт, который делают <em>мастера</em>'],
  ['h-section', 'Заголовок секции (H2)', 'Playfair Display 400 · 28→58 px', 'Честные правила, записанные <em>в договоре</em>'],
  ['h-card', 'Заголовок карточки (H3)', 'Manrope 600 · 19→23 px', 'Фиксированная смета'],
  ['lead', 'Подзаголовок', 'Manrope 400 · 17→20 px · muted', 'Дизайн-проект, фиксированная смета и собственный цех.'],
  ['body', 'Основной текст', 'Manrope 400 · 17 px · 1.6', 'Стоимость фиксируется в договоре после замера и утверждения проекта.'],
  ['eyebrow', 'Надзаголовок', 'Manrope 700 · 12.5 px · caps · трекинг 0.16em', 'Почему нам доверяют'],
];
const icons = ['doc', 'steps', 'factory', 'check', 'eye', 'leaf', 'shield', 'ruler', 'pencil', 'clock', 'wallet', 'camera', 'spark', 'saw', 'paint'];
const arts = Object.keys(ART_LABELS) as ArtVariant[];
---

<Base title="Дизайн-система" description="Цвета, шрифты и компоненты сайта." noindex>
  <section class="section section--tight">
    <div class="container sg">
      <header class="sg-head">
        <p class="eyebrow">Служебная страница</p>
        <h1 class="h-display">Дизайн-система</h1>
        <p class="lead">Цвета, шрифты и компоненты сайта в текущем виде. Все значения — переменные в <code>src/styles/global.css</code>.</p>
      </header>

      <section>
        <h2 class="h-section">Цвета</h2>
        <div class="swatches">
          {
            colors.map(([name, hex, role]) => (
              <figure class="sw">
                <span class="chipc" style={`background:${hex}`} />
                <figcaption>
                  <b>{hex}</b>
                  <code>{name}</code>
                  <small>{role}</small>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="h-section">Типографика</h2>
        <p class="muted">Шрифты: <b>Playfair Display</b> (заголовки, курсив — для акцентных слов медью) и <b>Manrope</b> (текст и интерфейс). Оба бесплатные, есть в Google Fonts, поддерживают кириллицу.</p>
        <div class="type">
          {
            type.map(([cls, name, spec, sample]) => (
              <div class="trow">
                <div class="tmeta">
                  <b>{name}</b>
                  <small>{spec}</small>
                </div>
                <p class={cls === 'body' ? '' : cls} set:html={sample} />
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="h-section">Кнопки и метки</h2>
        <div class="row">
          <button class="btn btn--accent">Основное действие <span class="arrow">→</span></button>
          <button class="btn">Тёмная кнопка</button>
          <button class="btn btn--ghost">Второстепенная</button>
          <span class="chip">Метка / чип</span>
        </div>
        <div class="row dark">
          <button class="btn btn--accent">На тёмном фоне</button>
          <button class="btn btn--ghost">Второстепенная</button>
          <button class="btn btn--light">Светлая</button>
          <span class="chip">Чип на тёмном</span>
        </div>
        <ul class="tick-list narrow">
          <li>Список с галочками — для преимуществ и состава работ</li>
          <li>Скругления: карточки 22 px, поля и мелкие блоки 14 px, кнопки — полностью круглые</li>
        </ul>
      </section>

      <section>
        <h2 class="h-section">Иконки</h2>
        <p class="muted">Линейные, 24×24, толщина линии 1.6. Находятся в <code>src/components/Icon.astro</code>.</p>
        <div class="icons">
          {
            icons.map((n) => (
              <figure>
                <span class="ic"><Icon name={n} /></span>
                <figcaption>{n}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="h-section">Изображения</h2>
        <p class="muted">Формат 4:3, 1600×1200 и 800×600 (WebP) в <code>public/images/art/</code>. Чтобы заменить иллюстрацию фотографией, положите файл с тем же именем.</p>
        <div class="arts">
          {
            arts.map((a) => (
              <figure>
                <div class="media"><Art variant={a} sizes="300px" /></div>
                <figcaption>
                  <code>{a}.webp</code> — {ART_LABELS[a]}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="h-section">Компоненты</h2>
        <h3 class="h-card sub">Пакеты</h3>
        <Packages />
        <div class="two">
          <div>
            <h3 class="h-card sub">Слайдер «до / после»</h3>
            <BeforeAfter variant="kitchen" />
          </div>
          <div>
            <h3 class="h-card sub">Форма заявки</h3>
            <div class="card"><LeadForm source="Дизайн-система" withMessage /></div>
          </div>
        </div>
        <h3 class="h-card sub">Вопросы и ответы</h3>
        <Faq items={[{ q: 'Раскрытый вопрос', a: 'Ответ показывается плавно. Открыт только один вопрос в группе.' }, { q: 'Закрытый вопрос', a: 'Текст ответа.' }]} />
      </section>
    </div>
  </section>
</Base>

<style>
  .sg {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
  }

  .sg > * {
    min-width: 0;
  }

  .sg-head {
    display: grid;
    gap: 18px;
  }

  section > .h-section {
    margin-bottom: 24px;
  }

  code {
    font-size: 0.85em;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--paper-2);
  }

  .swatches {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .sw {
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .chipc {
    display: block;
    height: 96px;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .sw figcaption {
    display: grid;
    gap: 2px;
    font-size: 0.9rem;
  }

  .sw small {
    color: var(--muted);
  }

  .type {
    display: grid;
    border-top: 1px solid var(--line);
    margin-top: 16px;
  }

  .trow {
    display: grid;
    gap: 12px 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .trow {
      grid-template-columns: 260px 1fr;
      align-items: center;
    }
  }

  .trow > * {
    min-width: 0;
  }

  .trow p {
    margin: 0;
  }

  .tmeta {
    display: grid;
    gap: 4px;
  }

  .tmeta small {
    color: var(--muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
  }

  .row.dark {
    margin-top: 12px;
    background: var(--graphite);
    color: var(--paper);
    border-color: var(--graphite);
    --accent: #c08a5f;
  }

  .row.dark .btn--ghost {
    --fg: var(--paper);
    border-color: var(--line-dark);
  }

  .row.dark .chip {
    border-color: var(--line-dark);
    background: rgb(255 255 255 / 0.04);
  }

  .narrow {
    margin-top: 24px;
    max-width: 70ch;
  }

  .icons {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    margin-top: 16px;
  }

  .icons figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .ic {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .arts {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    margin-top: 16px;
  }

  .arts figure {
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .arts .media {
    aspect-ratio: 4 / 3;
  }

  .arts figcaption {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .sub {
    margin: 32px 0 16px;
  }

  .two {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 1000px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .two > * {
    min-width: 0;
  }
</style>
