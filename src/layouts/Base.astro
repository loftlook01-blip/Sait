---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import SiteWidgets from '../components/SiteWidgets.astro';
import { SITE } from '../data/site';
import { PRIMARY_CITY, type City } from '../data/cities';
import { organization, website } from '../lib/schema';
import manropeCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import playfairCyr from '@fontsource-variable/playfair-display/files/playfair-display-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  city?: City;
  schema?: object[];
  noindex?: boolean;
  ogImage?: string;
  /** Шапка прозрачная поверх первого экрана (главные страницы) */
  overlayHeader?: boolean;
}

const { title, description, city = PRIMARY_CITY, schema = [], noindex = false, ogImage = '/og.jpg', overlayHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Бренд добавляем, только если заголовок не слишком длинный (сниппет Яндекса ~70 символов)
const fullTitle = title.includes(SITE.brand) || title.length > 52 ? title : `${title} — ${SITE.brand}`;
const ld = [organization(city), website(), ...schema];
const metrika = SITE.analytics.yandexMetrikaId;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={manropeCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairCyr} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {overlayHeader && <link rel="preload" as="image" href="/images/art/hero.webp" imagesrcset="/images/art/hero-1200.webp 1200w, /images/art/hero.webp 1920w" imagesizes="100vw" />}

    <meta name="theme-color" content="#1f1d19" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / соцсети и мессенджеры -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="vk:image" content={new URL(ogImage, SITE.url).href} />

    <!-- Гео-разметка для локального поиска -->
    <meta name="geo.region" content={city.regionCode} />
    <meta name="geo.placename" content={city.name} />
    <meta name="geo.position" content={`${city.lat};${city.lng}`} />
    <meta name="ICBM" content={`${city.lat}, ${city.lng}`} />

    {SITE.analytics.yandexVerification && <meta name="yandex-verification" content={SITE.analytics.yandexVerification} />}
    {SITE.analytics.googleVerification && <meta name="google-site-verification" content={SITE.analytics.googleVerification} />}

    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {
      metrika && (
        <script is:inline define:vars={{ metrika }}>
          (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
          ym(metrika, "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
          window.__ym = metrika;
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header city={city} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer city={city} />
    <LeadModal />
    <SiteWidgets />
  </body>
</html>
