---
import { SITE } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { light }]} aria-label={`${SITE.brand} — на главную`}>
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><path d="M3 29V13L16 3l13 10v16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M16 9.5 11.5 15h2.7L10.5 20h3.2L10 25h12l-3.7-5h3.2L17.8 15h2.7Z" fill="currentColor"/><path d="M16 25v4" stroke="currentColor" stroke-width="2.4"/></svg>
  <span class="logo-text"><b>{SITE.brand}</b><small>{SITE.brandSub}</small></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--green); }
  .logo.light { color: #fff; }
  .logo-text { display: grid; line-height: 1; }
  .logo b { font-size: 22px; letter-spacing: 0.04em; font-weight: 800; }
  .logo small { font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 4px; padding-top: 3px; border-top: 1px solid currentColor; opacity: 0.8; }
</style>
