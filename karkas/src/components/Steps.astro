---
import { STEPS } from '../data/content';
---
<ol class="steps">
  {STEPS.map((s, i) => (
    <li class="step card reveal" style={`transition-delay:${i * 60}ms`}>
      <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
      <span class="step-d">{s.d}</span>
      <h3 class="step-t">{s.t}</h3>
      <p>{s.x}</p>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); counter-reset: s; }
  .step { padding: clamp(20px, 2.5vw, 30px); display: grid; gap: 10px; align-content: start; position: relative; overflow: hidden; }
  .step-n { font-size: 64px; font-weight: 800; line-height: 1; color: var(--green-soft); position: absolute; right: 18px; top: 12px; letter-spacing: -0.04em; }
  .step-d { justify-self: start; font-size: 13px; font-weight: 700; padding: 5px 10px; border-radius: 999px; background: var(--green); color: #fff; }
  .step-t { font-size: 19px; text-transform: uppercase; max-width: 16ch; position: relative; }
  .step p { color: var(--ink-2); font-size: 15px; position: relative; }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .steps { grid-template-columns: 1fr; } }
</style>
