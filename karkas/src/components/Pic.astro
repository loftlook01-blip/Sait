---
/** Картинка из /public/images: name.webp (1600px) + name-800.webp. Ленивая загрузка по умолчанию. */
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string; w?: number; h?: number }
const { name, alt, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, class: cls, w = 1600, h = 1200 } = Astro.props;
---
<img
  class={cls}
  src={`/images/${name}.webp`}
  srcset={`/images/${name}-800.webp 800w, /images/${name}.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width={w}
  height={h}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
